%simulation with extended dimension to eliminate singularity
clc; clear; close all;

libPath = fullfile(pwd, "lib");
addpath(genpath(libPath));

dt = 0.001; params.dt = dt;                     %s
simTime = 150; params.simTime = simTime;        %s
N = floor(simTime/dt);

syms x y w;

% --------------------- Path Following function Setup ---------------------
% Circle/Ellipse
% beta = 0.01; a = 50; b = 100; %beta = 0.1        %m
% fnS.x = a * cos(beta * w);
% fnS.y = b * sin(beta * w);
% kappa = [0.06, 0.025]; params.kappa = kappa; %[0.7, 0.7]

%                               ************
% % Straight Line (ax + by = c)
% beta = 1;
% fnS.x = beta * w;
% fnS.y = 100 - beta * w;
% kappa = [0.06, 0.06]; params.kappa = kappa;

%                               ************
% % Parabola(x^2 = 4ay)
% beta = 0.01; a = 100;
% fnS.x = 2 * a * beta * w;
% fnS.y = a * (beta * w)^2;
% kappa = [0.06, 0.06]; params.kappa = kappa;

%                               ************
% 8-shaped curve
beta = 0.01; a = 200;
fnS.x = a * sin(beta * w);
fnS.y = a * sin(beta * w) * cos(beta * w);
kappa = [0.1, 0.1]; params.kappa = kappa;
%--------------------------------------------------------------------------


params.fnS = fnS;
fnM.x = matlabFunction(fnS.x, "Vars", w);
fnM.y = matlabFunction(fnS.y, "Vars", w);
params.fnM = fnM;

% params = calculateParams(params);

% %-------------------------- Obstacle Definition ---------------------------
% %Obstacle definition must be defined one function like: g(x, y, z) = 0
% %%Circle
% o = [100, 100]'; r = 50;
% params.gnS = (x - o(1))^2 + (y - o(2))^2 - r^2;
% params.gnM = matlabFunction(params.gnS, "Vars", [x, y]);
% 
% params.dgnSdx = diff(params.gnS, x); params.dgnSdy = diff(params.gnS, y);
% params.dgnMdx = matlabFunction(params.dgnSdx, "Vars", [x, y]);
% params.dgnMdy = matlabFunction(params.dgnSdy, "Vars", [x, y]);



%--------------------------- Setup Variables ------------------------------
s = -1; params.s = s;
g = 9.81; params.g = g;                         %m/s^2
phiMax = pi/4; params.phiMax = phiMax;          %radians
region = [
    -200, 200;
    -200, 200;
    -400, 400
]; params.region = region;


va = 15; params.va = va;                        %m/s
wind = [3, 4]'; params.wind = wind;             %m/s
p0 = [200, -200]';
w0 = initializeCurveParameter(p0, params.fnS, region(3, :));
p0 = [p0', w0]'; params.p0 = p0;                %m
chi0 = -3*pi/4;                                    %radians

controller = "Dist"; params.controller = controller;
tol = 0.01; params.tol = tol;                   %m/s
kchi = 10; params.kchi = kchi;                  %1/s

% controller = "Vel"; params.controller = controller;
% k = 50; params.k = k; %500

%Obstacle Distance Margin (Safety Margin)
delta = 2 * va^2 / (g * tan(phiMax)); params.delta = delta;

%Smooth Field Switch factor (can't be zero)
%(on increasing switching distance increases)
alpha = 25; params.alpha = alpha;

%--------------------------------------------------------------------------

% Plotting the Vector Field
planes = [
    % 0, 0, 0, phiThetaToUnitVector(pi/4, pi/4)';
    % 0, 0, 0, phiThetaToUnitVector(3*pi/4, pi/4)';
    0, 0, 0, phiThetaToUnitVector(0, pi/2)'
    ];
handles = plotVF(params, region, planes);

[handles, updatePlotTrajectory]= initializePlotTrajectory(params, handles);


%-------------------------- State Definitions -----------------------------
%Kxy: curvature in XY plane
% states.state: [x, y, w, dx, dy, dw, ddx, ddy, ddw, Vg, Kxy, r]'
states.state = zeros(12, N + 1);
VTP0 = [fnM.x(p0(3)), fnM.y(p0(3)), p0(3)]';
states.state(:, 1) = [p0', zeros(1, 3), zeros(1, 3), 0, 0, norm(p0 - VTP0)]';

% states.miscState: [omega1, omega2, omega3, chi, dChi]';
states.miscState = zeros(5, N + 1);
states.miscState(4, 1) = chi0;
%--------------------------------------------------------------------------



VFAtPoint = createVFAtPointMatFunc(fnS, s, kappa);
fprintf("Simulation started...\n");
progressbar("Initialize", [1, N]);
for i = 1:N
    p = states.state(1:3, i);
    chi = states.miscState(4, i);

    Vg = wind(1) * cos(chi) + wind(2) * sin(chi) + sqrt(va^2 ...
        - (wind(1) * sin(chi) - wind(2) * cos(chi))^2);

    vd = reshape(VFAtPoint(p(1), p(2), p(3)), [3, 1]);
    normvd = vd ./ norm(vd);                 %desired Velocity with 'Vg' = total Velocity
   

    if(i == 1)
        v = [
            Vg * cos(chi);
            Vg * sin(chi);
            0
        ];
        states.state(4:6, 1) = v;
    end
    v = states.state(4:6, i);


    
    if(params.controller == "Vel")
        [dv, omega]= navVelocityController(params, v, Vg * normvd);
        states.miscState(1:3, i) = omega;
    elseif(params.controller == "Dist")
        [vNew, chiNew, dChi] = navDistribController(params, v, normvd, tol, kchi);
        %v: actual velocity vector, normvd: normalized desired velocity
        %vector

        dv = (vNew - v) ./ dt;   %forward euler

        states.miscState(5, i) = dChi;
        states.miscState(4, i + 1) = chiNew;
    else
        error("Please select a Valid Controller: 'Vel' or 'Dist'\n");
    end

    % Kxy = abs(v(1) * dv(2) - v(2) * dv(1)) / (v(1)^2 + v(2)^2)^(3/2);
    Kxy = dChi / Vg;

    % vNew = v + dt .* dv; %[dv = (vNew - v)/dt]; acceleration applied at time-step 'i'
    pNew = p + dt .* vNew;

    VTPNew = [
      fnM.x(pNew(3));
      fnM.y(pNew(3));
      pNew(3);
    ];
    
    states.state(7:11, i) = [dv', Vg, Kxy]';
    states.state(1:6, i + 1) = [pNew', vNew'];
    states.state(12, i + 1) = norm(pNew - VTPNew);
    
    if(i == 1 || mod(i, 100) == 0 || i == N)
        updatePlotTrajectory(states, i);
    end
    progressbar(i);
end
fprintf("Simulation complete.\n")

handles = plotParams(params, handles, states);
